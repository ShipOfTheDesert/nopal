#!/usr/bin/env bash
set -euo pipefail

# Fail loudly, before Tauri does, on either of the two ways a fresh/regenerated
# checkout is not buildable for Android (RFC 0116, feature 0121 M3):
#
#   1. Clobbered bridge — MainActivity.kt is the one tracked file in the
#      otherwise generated/gitignored gen/android tree; `tauri android init`
#      silently overwrites it with Tauri's default stub, which builds fine but
#      drops the safe-area / soft-keyboard reads. Remedy: restore it from git.
#   2. Missing project (fresh clone) — MainActivity.kt is tracked so it is
#      present after `git clone`, but the rest of the gen/android Gradle project
#      is gitignored and absent until `tauri android init` runs. The old guard
#      only checked the tracked file, so a fresh clone passed the guard and then
#      failed deep inside Tauri. Remedy: init the project, then restore the
#      hand-written bridge that init clobbers (init + checkout, in that order).

rel='tauri/src-tauri/gen/android/app/src/main/java/run/nopal/kitchen_sink/MainActivity.kt'
# Top-level marker that `tauri android init` has generated the Gradle project.
# It is gitignored (regenerated), so on a fresh clone it is absent even though
# the tracked MainActivity.kt is present.
project_marker='tauri/src-tauri/gen/android/build.gradle.kts'

# check_bridge ROOT — verify the Android native bridge is intact AND the
# generated Gradle project is present under ROOT. Prints the exact
# copy-pasteable remedy on stderr and returns non-zero on the first failure.
check_bridge() {
  local root="$1"
  local activity="$root/$rel"

  if [ ! -f "$activity" ] || ! grep -q 'report_safe_area' "$activity"; then
    {
      echo "error: the hand-written Android native bridge is missing from"
      echo "  $rel"
      echo
      echo "'tauri android init' regenerates this file with a default stub, dropping"
      echo "the RFC 0116 safe-area / soft-keyboard reads. Restore the tracked version:"
      echo
      echo "    git checkout -- $rel"
      echo
    } >&2
    return 1
  fi

  if [ ! -f "$root/$project_marker" ]; then
    {
      echo "error: the generated Android project is missing under"
      echo "  tauri/src-tauri/gen/android/ (only the tracked MainActivity.kt is present)"
      echo
      echo "This is a fresh checkout: 'tauri android init' has not generated the Gradle"
      echo "project yet. Because init also clobbers the hand-written bridge, init first"
      echo "and then restore MainActivity.kt from version control (in this order):"
      echo
      echo "    (cd tauri && npm exec tauri android init)"
      echo "    git checkout -- $rel"
      echo
    } >&2
    return 1
  fi

  return 0
}

# --selftest — prove the guard fires on a fresh-clone fixture and passes on a
# complete-project fixture. Fixtures are built in a temp tree so the check is
# exercised against a controlled ROOT, independent of the real repo state.
# Follows scripts/lint-classes --selftest.
selftest() {
  local rc=0
  local tmp
  tmp="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" RETURN

  # Fixture A — fresh clone: the tracked MainActivity.kt is present with its
  # sentinel, but `tauri android init` has not generated the Gradle project.
  local a="$tmp/a"
  mkdir -p "$a/$(dirname "$rel")"
  printf 'fun report_safe_area() {}\n' > "$a/$rel"

  # Fixture B — complete project: bridge present AND the generated marker.
  local b="$tmp/b"
  mkdir -p "$b/$(dirname "$rel")" "$b/$(dirname "$project_marker")"
  printf 'fun report_safe_area() {}\n' > "$b/$rel"
  printf '// generated by tauri android init\n' > "$b/$project_marker"

  echo "android-require-bridge --selftest:"

  # Case (a): missing gen/android project -> non-zero + init+checkout remedy.
  local err_a rc_a=0
  err_a="$(check_bridge "$a" 2>&1 1>/dev/null)" || rc_a=$?
  if [ "$rc_a" -ne 0 ] \
     && printf '%s' "$err_a" | grep -q 'tauri android init' \
     && printf '%s' "$err_a" | grep -q -- "git checkout -- $rel"; then
    echo "  ok   fresh clone (missing gen/android project) fails with init+checkout remedy"
  else
    echo "  FAIL fresh clone case: exit $rc_a, stderr was:" >&2
    printf '%s\n' "$err_a" | sed 's/^/    /' >&2
    rc=1
  fi

  # Case (b): complete project -> exit 0.
  local rc_b=0
  check_bridge "$b" >/dev/null 2>&1 || rc_b=$?
  if [ "$rc_b" -eq 0 ]; then
    echo "  ok   complete project passes"
  else
    echo "  FAIL complete project case: exit $rc_b (expected 0)" >&2
    rc=1
  fi

  if [ "$rc" -eq 0 ]; then
    echo "android-require-bridge --selftest: PASS"
  fi
  return "$rc"
}

REPO_ROOT="$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)"

case "${1:-}" in
  --selftest) selftest ;;
  "") check_bridge "$REPO_ROOT" ;;
  *)
    echo "usage: android-require-bridge [--selftest]" >&2
    exit 2
    ;;
esac
